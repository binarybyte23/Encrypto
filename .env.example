# Server
PORT=5001
CLIENT_URL=http://localhost:5173
TRUST_PROXY=0
# Production: point this at a persistent volume, e.g. /data/encrypto.db
DATABASE_PATH=./server/encrypto.db
ADMIN_TOKEN=change-me-long-random
FORENSIC_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Client (local dev only, put in client/.env). Leave empty in production
# so the client uses the same origin that serves it.
VITE_SOCKET_URL=http://localhost:5001
